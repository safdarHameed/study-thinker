{
  "name": "studythinker",
  "private": true,
  "description": "StudyThinker — learn anything, your way",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:deploy": "pnpm --filter api db:deploy",
    "db:studio": "pnpm --filter api db:studio",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d postgres",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "stack:up": "docker compose -f infrastructure/docker/docker-compose.yml --profile apps up -d --build",
    "stack:down": "docker compose -f infrastructure/docker/docker-compose.yml --profile apps down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.12"
  }
}
