# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed by CORS (the web app)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=log

# ── Database (Postgres 16+) ──────────────────────────────
# Docker Compose (pnpm infra:up) exposes Postgres on host port 5433.
DATABASE_URL=postgresql://learnwell:learnwell@localhost:5433/learnwell?schema=public

# ── Auth ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true when serving over HTTPS (production)
COOKIE_SECURE=false
# Optional cookie domain, e.g. .studythinker.app (leave empty for localhost)
COOKIE_DOMAIN=

# ── AI ───────────────────────────────────────────────────
# Encrypts learners' own provider API keys at rest. Must differ from JWT_ACCESS_SECRET.
# Changing it makes saved keys unreadable (learners re-enter them).
# Generate with: openssl rand -base64 48
AI_KEYS_SECRET=change-me-ai-keys-secret-at-least-32-characters

# Built-in models: a Hugging Face token with "Make calls to Inference Providers"
# (https://huggingface.co/settings/tokens). Usage is billed to this token's account
# (free accounts need prepaid credits; PRO includes a small monthly credit).
# Leave empty and learners must connect their own provider key in Settings → AI.
HF_TOKEN=
# Chat models offered as built-in choices; the first is the default.
# HF_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,openai/gpt-oss-120b,zai-org/GLM-5.3-Flash,Qwen/Qwen3.8-27B,meta-llama/Llama-3.3-70B-Instruct
# Speech-to-text for spoken answers (HF Inference). Without HF_TOKEN, the browser transcribes.
# HF_ASR_MODEL=openai/whisper-large-v3
AI_TIMEOUT_MS=120000
# Development only: set to 1 to offer "Claude Code (this computer)" in Settings → AI.
# Answers come from the `claude` CLI signed in on this computer (your own Claude Code
# account). Never enable on a shared or deployed server. CLAUDE_CODE_BIN overrides the path.
# CLAUDE_CODE_LOCAL=1

# ── Email (password resets) ──────────────────────────────
#   log    - write the email to the API log (development)
#   none   - don't send
#   resend - send with Resend (needs RESEND_API_KEY and MAIL_FROM)
MAIL_TRANSPORT=log
# MAIL_FROM="StudyThinker <hello@your-domain.example>"
# RESEND_API_KEY=
PASSWORD_RESET_TTL_MINUTES=30

# ── Misc ─────────────────────────────────────────────────
# Run `prisma migrate deploy` on container start (Docker image only)
RUN_MIGRATIONS=false
SWAGGER_ENABLED=true
