// StudyThinker data model.
//
// - Primary keys are time-ordered UUIDv7.
// - Learning options, preferences, lesson content, assessment questions and
//   results are JSON validated by zod schemas in @studythinker/shared, so new
//   learning and assessment styles don't need migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum LearningStatus {
  DRAFT
  BUILDING
  READY
  FAILED
}

// ─────────────────────── Identity ───────────────────────

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique @db.VarChar(254)
  passwordHash       String
  displayName        String     @db.VarChar(80)
  role               UserRole   @default(LEARNER)
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @db.Timestamptz(3)
  /// null = built-in Hugging Face models
  activeConnectionId String?    @db.Uuid
  /// Built-in model chosen by the learner (null = server default)
  builtInModel       String?    @db.VarChar(200)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)

  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  aiConnections       AiConnection[]
  learnings           Learning[]
  activities          Activity[]

  @@map("users")
}

/// One row per refresh-token family member. Re-use of a rotated token revokes the family.
model AuthSession {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique @db.Char(64)
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime  @db.Timestamptz(3)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

/// A learner's own model provider. The API key is encrypted (AES-256-GCM).
model AiConnection {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @db.Uuid
  provider     String   @db.VarChar(40)
  label        String   @db.VarChar(60)
  model        String   @db.VarChar(200)
  baseUrl      String?  @db.VarChar(300)
  encryptedKey String
  keyHint      String   @db.VarChar(12)
  /// Models that answered a test call with this key: [{ id, label, recommended? }]
  models       Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_connections")
}

// ─────────────────────── Learning ───────────────────────

model Learning {
  id          String         @id @default(uuid(7)) @db.Uuid
  userId      String         @db.Uuid
  title       String         @db.VarChar(120)
  topic       String         @db.VarChar(200)
  description String?
  status      LearningStatus @default(DRAFT)
  /// LearningOptions — what the AI proposed
  options     Json?
  /// LearningPreferences — what the learner chose
  preferences Json?
  overview    String?
  error       String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps         Step[]
  conversations Conversation[]
  assessments   Assessment[]
  revisions     Revision[]
  activities    Activity[]

  @@index([userId, updatedAt])
  @@map("learnings")
}

model Step {
  id              String    @id @default(uuid(7)) @db.Uuid
  learningId      String    @db.Uuid
  key             String    @db.VarChar(40)
  title           String    @db.VarChar(160)
  summary         String
  kind            String    @db.VarChar(20)
  group           String?   @db.VarChar(120)
  parentKey       String?   @db.VarChar(40)
  dependsOn       String[]
  position        Int
  minutes         Int
  mode            String?   @db.VarChar(20)
  assessmentStyle String?   @db.VarChar(20)
  status          String    @default("todo") @db.VarChar(20)
  /// LessonContent
  lesson          Json?
  completedAt     DateTime? @db.Timestamptz(3)
  /// Slides and games made for this step, on demand.
  media           Json?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  learning      Learning       @relation(fields: [learningId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  assessments   Assessment[]

  @@unique([learningId, key])
  @@index([learningId, position])
  @@map("steps")
}

model Conversation {
  id         String   @id @default(uuid(7)) @db.Uuid
  learningId String   @db.Uuid
  stepId     String?  @db.Uuid
  kind       String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  learning   Learning    @relation(fields: [learningId], references: [id], onDelete: Cascade)
  step       Step?       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  messages   Message[]
  assessment Assessment?

  @@index([learningId, kind, stepId])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid(7)) @db.Uuid
  conversationId String   @db.Uuid
  role           String   @db.VarChar(12)
  content        String
  /// Changes applied by the coach in response to this message
  changes        String[]
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Assessment {
  id             String   @id @default(uuid(7)) @db.Uuid
  learningId     String   @db.Uuid
  stepId         String?  @db.Uuid
  style          String   @db.VarChar(20)
  title          String   @db.VarChar(160)
  instructions   String
  status         String   @default("open") @db.VarChar(12)
  /// Questions including answers and rubrics (stripped before sending)
  questions      Json
  answers        Json?
  result         Json?
  score          Int?
  error          String?
  conversationId String?  @unique @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  learning     Learning      @relation(fields: [learningId], references: [id], onDelete: Cascade)
  step         Step?         @relation(fields: [stepId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([learningId, createdAt])
  @@map("assessments")
}

/// Snapshot taken before an AI-applied change, so the learner can undo it.
model Revision {
  id         String   @id @default(uuid(7)) @db.Uuid
  learningId String   @db.Uuid
  summary    String
  snapshot   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  learning Learning @relation(fields: [learningId], references: [id], onDelete: Cascade)

  @@index([learningId, createdAt])
  @@map("revisions")
}

/// Something the learner did, worth XP. Feeds streaks, badges and history.
model Activity {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @db.Uuid
  learningId String?  @db.Uuid
  kind       String   @db.VarChar(30)
  /// What it was about (a step id, conversation id…) so rewards aren't given twice.
  ref        String?  @db.VarChar(80)
  label      String   @db.VarChar(200)
  xp         Int
  /// Extra numbers, e.g. an assessment score.
  value      Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  learning Learning? @relation(fields: [learningId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([learningId, createdAt])
  @@index([userId, kind, ref])
  @@map("activities")
}
