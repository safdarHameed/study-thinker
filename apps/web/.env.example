# Public base URL of the StudyThinker API, used by the browser. Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# API URL reachable from the Next.js server (e.g. the docker network name).
# Reserved for server-side calls; the browser always uses NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://api:4000

# Set to "false" when the API runs on a different site and its `lw_session`
# cookie is not visible to this app (disables proxy.ts redirect UX).
LW_PROXY_AUTH_REDIRECTS=true
